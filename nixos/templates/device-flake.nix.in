# /etc/hinteros/flake.nix, generated by the installer. Never hand-edited, and never rewritten for
# new behavior: that lives in hinteros.lib.deviceOutputs (nixos/lib/device-outputs.nix). A channel
# switch rewrites the url alone. See hinteros-docs/design/device-config.md.
{
  inputs.hinteros.url = "git+%REPO%?ref=%CHANNEL%";

  outputs = { hinteros, ... }: hinteros.lib.deviceOutputs ./.;
}
