# hinteros.lib.mkDevice: builds a device's nixosSystem from its state.json contents.
{ self, nixpkgs }:
{
  # Decoded state.json (an attrset).
  state,
  # Path to a nixos-facter report, or null: the device then gets generic hardware support
  # (nixos/modules/generic-hardware.nix), the same on every machine.
  facterReport ? null,
  # The device config dir (flake.nix, flake.lock, state.json) this system is built from; embedded
  # in the toplevel as the generation snapshot. null: the snapshot is just state.json.
  configDir ? null,
  # A checked-in device (`self.lib.devices.<selfFlake>`, the dev box) without a config dir: the
  # snapshot gets a generated device flake naming this repo by store path, whose
  # `nixosConfigurations.hinteros` is `self.lib.devices.<selfFlake> { state = <its state.json>; }`
  # So /etc/hinteros on the box evaluates like any box's, app envs included, and
  # a state.json that hinteros-system rewrites there takes effect.
  selfFlake ? null,
  # Extra NixOS modules (hardware profiles, the dev box's extras).
  extraModules ? [ ],
  # nixpkgs base: "unstable", the only one (HinterOS has no stable base).
  base ? state.base or "unstable",
}:
let
  inherit (nixpkgs) lib;

  # One base by design: unstable nixpkgs. state.json `base` stays, so any other value fails here.
  nixpkgsFor = {
    unstable = nixpkgs;
  };

  # This repo's source and every flake input below it. Kept with the system
  # (system.extraDependencies), so a GC never leaves the box unable to evaluate an app env
  # offline (otherwise only nixpkgs' source survives).
  flakeSources = map (x: x.flake.outPath) (
    builtins.genericClosure {
      startSet = [
        {
          key = self.outPath;
          flake = self;
        }
      ];
      operator =
        x:
        map (f: {
          key = f.outPath;
          flake = f;
        }) (lib.attrValues (x.flake.inputs or { }));
    }
  );

  # The env manifests' `system_rev`. A dirty tree gets the placeholder the installer's offline
  # lock uses for it too (nixos/installer: isoRev), so the ISO's starter envs are the ones an
  # install from that ISO evaluates.
  rev = self.rev or "0000000000000000000000000000000000000000";

  embeddedFlake =
    let
      # No lastModified: a path input gets its own, which would make the embedded flake's snapshot
      # differ from the repo's (the toplevel must be the same from either).
      locked = {
        type = "path";
        path = self.outPath;
        inherit (self) narHash;
      };
    in
    {
      flake = ''
        # Generated by hinteros.lib.mkDevice (selfFlake = "${selfFlake}"): the checked-in device,
        # with this box's state.json. Do not edit; a deploy replaces it.
        {
          inputs.hinteros.url = "path:${self.outPath}";
          outputs =
            { hinteros, ... }:
            {
              nixosConfigurations.hinteros = hinteros.lib.devices.${selfFlake} {
                state = builtins.fromJSON (builtins.readFile ./state.json);
              };
            };
        }
      '';
      lock = builtins.toJSON (
        import ./device-lock.nix { inherit lib; } {
          selfLock = builtins.fromJSON (builtins.readFile (self + "/flake.lock"));
          inherit locked;
          original = {
            type = "path";
            path = self.outPath;
          };
        }
      );
    };
in
assert
  nixpkgsFor ? ${base}
  || throw "hinteros.lib.mkDevice: base \"${toString base}\" is not available (supported: ${builtins.concatStringsSep ", " (builtins.attrNames nixpkgsFor)})";
nixpkgsFor.${base}.lib.nixosSystem {
  system = "x86_64-linux";
  modules = [
    self.nixosModules.default
    { hinteros.state = state; }
    {
      # A console appliance: no man pages or NixOS manual (no builds of them on every rebuild,
      # nothing to carry on the installer ISO). A device can switch them back on.
      documentation.enable = nixpkgs.lib.mkDefault false;
      system.tools.nixos-generate-config.enable = nixpkgs.lib.mkDefault false;
      system.extraDependencies = flakeSources;
      hinteros.appEnv.systemRev = rev;
    }
    (nixpkgs.lib.optionalAttrs (configDir != null) { hinteros.deviceConfig.configDir = configDir; })
    (nixpkgs.lib.optionalAttrs (selfFlake != null) {
      hinteros.deviceConfig = { inherit embeddedFlake; };
    })
    (
      { config, lib, ... }:
      {
        hinteros = {
          session.enable = true;
          daemon.enable = true;
          # Every installed box (systemd-boot) counts its boots: a generation that never reaches
          # the boot-health gate (launcher and daemon up) is skipped after a few tries and the
          # previous one boots. Machines without systemd-boot (VMs, the ISO) cannot count.
          maintenance.bootCounting.enable = lib.mkDefault config.boot.loader.systemd-boot.enable;
        };
      }
    )
  ]
  ++ nixpkgs.lib.optional (facterReport != null) { hardware.facter.reportPath = facterReport; }
  ++ nixpkgs.lib.optional (facterReport == null) self.nixosModules.generic-hardware
  ++ extraModules;
}
