+// HinterOS: Xwayland #2 and later hold the apps the session daemon starts (design/sandbox.md).
+// Nothing set there counts beyond what an ordinary X11 app needs: no Steam or gamescope property
+// of a window (STEAM_GAME, STEAM_OVERLAY, STEAM_INPUT_FOCUS, GAMESCOPE_EXTERNAL_OVERLAY, ...) and
+// no property of the root window (GAMESCOPECTRL_BASELAYER_*, the tunables). An app's windows get
+// their app id from the process tree only, as without STEAM_GAME. #0 (home app, OSK, Steam) and
+// #1 (Steam games) keep everything.
+static bool xwayland_ctx_is_apps( xwayland_ctx_t *ctx )
+{
+	return ctx->xwayland_server && ctx->xwayland_server->get_index() >= 2;
+}
